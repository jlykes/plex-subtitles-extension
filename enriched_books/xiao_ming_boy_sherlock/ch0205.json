              "pinyin": "，",
              "definition": "comma"
            },
            {
              "hanzi": "看到",
              "pinyin": "kàn dào",
              "definition": "saw"
            },
            {
              "hanzi": "门边的",
              "pinyin": "mén biān de",
              "definition": "by the door"
            },
            {
              "hanzi": "东西",
              "pinyin": "dōng xī",
              "definition": "something"
            },
            {
              "hanzi": "起火了",
              "pinyin": "qǐ huǒ le",
              "definition": "was on fire"
