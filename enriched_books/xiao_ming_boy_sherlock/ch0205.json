              "pinyin": "zài",
              "definition": "at/in"
            },
            {
              "hanzi": "门边",
              "pinyin": "mén biān",
              "definition": "at the door"
            },
            {
              "hanzi": "对",
              "pinyin": "duì",
              "definition": "to"
            },
            {
              "hanzi": "太太",
              "pinyin": "tài tài",
              "definition": "wife"
            },
            {
              "hanzi": "大叫",
              "pinyin": "dà jiào",
              "definition": "shout loudly"
            },
            {
              "hanzi": "：",
              "pinyin": "：",
              "definition": "punctuation"
            },
            {
              "hanzi": "“",
              "pinyin": "“",
              "definition": "opening quotation mark"
            },
            {
              "hanzi": "不好了",
              "pinyin": "bù hǎo le",
              "definition": "Oh no"
            },
            {
              "hanzi": "，",
              "pinyin": "，",
              "definition": "comma"
            },
            {
